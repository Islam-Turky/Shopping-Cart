@model Product


<div class="d-flex w-100 justify-content-between">
    <div class="d-flex flex-column justify-content-center align-items-center align-content-center w-50">
        <img src="~/@Model.ProductImg" style="height: 500px" class="img-thumbnail" alt="...">
        <table class="table" style="width: 50%">
            <thead>
                <tr>
                    <th scope="col">Price</th>
                    <th scope="col">Avialbel Amount</th>
                    <th scope="col">Category</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@Model.ProductPrice LE</td>
                    <td>@Model.Amount</td>
                    <td>@Model?.Category</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
